local function playMacro()
    if #currentMacroData == 0 then
        UpdateStatus("Error", "No macro loaded")
        return
    end
    
    isPlaying = true
    PlacedUnits = {}
    
    task.spawn(function()
        UpdateStatus("Playing", currentMacroName)
        local startT = tick()
        local step = 1
        
        local Remote = ReplicatedStorage:WaitForChild("Remote", 10)
        if not Remote then
            isPlaying = false
            UpdateStatus("Error", "Remote not found")
            return
        end
        
        while isPlaying and step <= #currentMacroData do
            if getgenv().StopAllMacros then break end
            
            local eff = Workspace:FindFirstChild("Effect")
            if eff and (eff: FindFirstChild("Gameover") or eff:FindFirstChild("Victory")) then
                isPlaying = false
                UpdateStatus("Finished", "Game ended")
                break
            end
            
            local act = currentMacroData[step]
            local passed = tick() - startT
            local cash = getCash()
            local cost = act.Cost or 0
            
            local timeReady = (passed >= act.Time)
            local cashReady = (playbackMode == "Time") or (cash >= cost)
            
            if timeReady and cashReady then
                local success = false
                
                if act.Action == "Place" then
                    local retries = 0
                    while retries < 50 and isPlaying do
                        if cash >= cost then
                            SmartFire(Remote: FindFirstChild("SpawnUnit"),
                                     {act.UnitName, act.CFrame, act.Slot, act.Data}, 3)
                            task.wait(0.2)
                        end
                        
                        local unit = FindUnitByNameAndPosition(act.UnitName, act.CFrame, 3)
                        if unit then
                            PlacedUnits[unit] = true
                            UpdateStatus("Placed", act.UnitName)
                            success = true
                            break
                        end
                        
                        retries = retries + 1
                        task.wait(0.1)
                    end
                    
                elseif act.Action == "Upgrade" then
                    local unit = FindUnitByPosition(act.CFrame, 2)
                    if unit then
                        SmartFire(Remote:FindFirstChild("UpgradeUnit"), {unit}, 3)
                        UpdateStatus("Upgraded", unit. Name)
                        success = true
                    end
                    
                elseif act.Action == "Sell" then
                    local unit = FindUnitByPosition(act.CFrame, 2)
                    if unit then
                        SmartFire(Remote:FindFirstChild("SellUnit"), {unit}, 2)
                        PlacedUnits[unit] = nil
                        UpdateStatus("Sold", unit.Name)
                        success = true
                    end
                    
                elseif act.Action == "Ability" then
                    local unit = FindUnitByPosition(act.CFrame, 2)
                    if unit then
                        if act.AbilityData then
                            SmartFire(Remote:FindFirstChild("UnitAbility"),
                                     {act.SkillName, unit, act.AbilityData}, 2)
                        else
                            SmartFire(Remote:FindFirstChild("UnitAbility"),
                                     {act. SkillName, unit}, 2)
                        end
                        UpdateStatus("Ability", act.SkillName)
                        success = true
                    end
                end
                
                if success then
                    step = step + 1
                    task.wait(0.05)
                else
                    task.wait(0.2)
                end
                
            else
                local waitInfo = ""
                if not timeReady then
                    local waitTime = math.max(0, act.Time - passed)
                    waitInfo = string.format("⏱️ %. 1fs", waitTime)
                elseif not cashReady then
                    waitInfo = string.format("💰 %d/%d", cash, cost)
                end
                UpdateStatus("Waiting", waitInfo)
                task.wait(0.3)
            end
        end
        
        isPlaying = false
        UpdateStatus("Complete", "Finished!")
    end)
end

