-- [HELPER FUNCTIONS]
local function ParseTime(timeStr)
    if not timeStr then return "00:00" end
    local min, sec = timeStr:match("(%d+)%s*min%s*(%d+)%s*sec")
    if min and sec then
        return string.format("%02d:%02d", tonumber(min), tonumber(sec))
    end
    return timeStr
end

