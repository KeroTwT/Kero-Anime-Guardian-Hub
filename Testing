-- [HELPER FUNCTIONS]
local function CFrameToTable(cf)
    return {cf: GetComponents()}
end

local function TableToCFrame(tab)
    if type(tab) == "table" and #tab == 12 then
        return CFrame.new(unpack(tab))
    end
    return CFrame.new()
end

local function getCash()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        local cash = ls:FindFirstChild("Cash")
        if cash then return cash.Value end
    end
    return 0
end

local function getWave()
    local info = Workspace:FindFirstChild("Info")
    if info then
        local wave = info:FindFirstChild("Wave")
        if wave then return wave.Value end
    end
    return 0
end

local function getUnitUpgradeCost(unit)
    if unit and unit: FindFirstChild("Info") then
        local info = unit.Info
        if info:FindFirstChild("UpgradeCost") then
            return info.UpgradeCost. Value
        end
    end
    return 0
end

local function SmartFire(remote, args, maxRetries)
    if not remote then return false end
    args = args or {}
    maxRetries = maxRetries or 2
    
    for attempt = 1, maxRetries do
        local success = pcall(function()
            if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
                remote:FireServer(unpack(args))
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(unpack(args))
            end
        end)
        
        if success then return true end
        if attempt < maxRetries then task.wait(0.1) end
    end
    
    return false
end

local function FindUnitByNameAndPosition(unitName, targetCFrame, radius)
    radius = radius or 3
    local unitsFolder = Workspace:FindFirstChild("Units")
    if not unitsFolder then return nil end
    
    for _, u in pairs(unitsFolder:GetChildren()) do
        if string.find(u.Name, unitName) or u.Name == unitName then
            local rootPart = u:FindFirstChild("HumanoidRootPart") or u. PrimaryPart
            if rootPart then
                local dist = (rootPart.Position - targetCFrame.Position).Magnitude
                if dist < radius and not PlacedUnits[u] then
                    return u
                end
            end
        end
    end
    return nil
end

local function FindUnitByPosition(targetCFrame, radius)
    radius = radius or 2
    local unitsFolder = Workspace:FindFirstChild("Units")
    if not unitsFolder then return nil end
    
    local closest = nil
    local minDist = radius
    
    for _, u in pairs(unitsFolder:GetChildren()) do
        local rootPart = u:FindFirstChild("HumanoidRootPart") or u.PrimaryPart
        if rootPart then
            local dist = (rootPart.Position - targetCFrame.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = u
            end
        end
    end
    return closest
end

-- [MACRO FUNCTIONS]
local function SaveCurrentMacro()
    if currentMacroName == "" then return end
    
    local encoded = {}
    for _, action in ipairs(currentMacroData) do
        local cloned = table.clone(action)
        if cloned.CFrame and typeof(cloned.CFrame) == "CFrame" then
            cloned.CFrame = CFrameToTable(cloned.CFrame)
        end
        table.insert(encoded, cloned)
    end
    
    local success, err = pcall(function()
        writefile(MACRO_FOLDER ..  "/" .. currentMacroName .. ". json", HttpService:JSONEncode(encoded))
    end)
    
    if success then
        if Fluent then
            Fluent: Notify({Title = "Macro", Content = "Saved:  " .. currentMacroName, Duration = 2})
        end
        print("✅ Saved:  " .. currentMacroName)
    else
        print("❌ Error:  " .. tostring(err))
    end
end

local function LoadMacro(macroName)
    local filePath = MACRO_FOLDER ..  "/" .. macroName .. ".json"
    if not isfile(filePath) then return end
    
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(filePath))
    end)
    
    if not success then
        print("❌ Failed to load macro")
        return
    end
    
    currentMacroData = {}
    for _, data in ipairs(result) do
        local action = table.clone(data)
        if action.CFrame and type(action.CFrame) == "table" then
            action.CFrame = TableToCFrame(action. CFrame)
        end
        table.insert(currentMacroData, action)
    end
    
    currentMacroName = macroName
    if Fluent then
        Fluent:Notify({Title = "Macro", Content = "Loaded: " .. macroName, Duration = 2})
    end
    print("✅ Loaded:  " .. macroName)
end

local function GetMacroFiles()
    local files = listfiles(MACRO_FOLDER)
    local names = {}
    for _, filePath in ipairs(files) do
        local name = filePath:match("([^/]+)%. json$")
        if name then
            table.insert(names, name)
        end
    end
    return names
end

-- [RECORDING HOOK]
local AllowedRemotes = {
    ["SpawnUnit"] = true,
    ["SellUnit"] = true,
    ["UpgradeUnit"] = true,
    ["UnitAbility"] = true,
    ["ChangeUnitModeFunction"] = true,
    ["BuyMeat"] = true,
    ["FeedAll"] = true,
    ["SkipEvent"] = true,
    ["x2Event"] = true
}

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    if checkcaller() then return oldNamecall(self, .. .) end
    if not isRecording then return oldNamecall(self, ...) end
    
    local method = getnamecallmethod()
    if (method == "InvokeServer" or method == "FireServer") and AllowedRemotes[self. Name] then
        local rName, args = self.Name, {... }
        
        task.spawn(function()
            pcall(function()
                local currentTime = tick() - startTime
                local currentWave = getWave()
                local preCash = getCash()
                
                if rName == "SpawnUnit" then
                    task.wait(0.5)
                    table.insert(currentMacroData, {
                        Action = "Place",
                        Time = currentTime,
                        Wave = currentWave,
                        Cost = math.max(0, preCash - getCash()),
                        UnitName = args[1],
                        CFrame = args[2],
                        Slot = args[3],
                        Data = args[4]
                    })
                    
                elseif rName == "UpgradeUnit" then
                    task.wait(0.5)
                    local u = args[1]
                    if u and u. PrimaryPart then
                        table.insert(currentMacroData, {
                            Action = "Upgrade",
                            Time = currentTime,
                            Wave = currentWave,
                            Cost = math.max(0, preCash - getCash()),
                            CFrame = u.PrimaryPart. CFrame
                        })
                    end
                    
                elseif rName == "SellUnit" then
                    local u = args[1]
                    if u and u.PrimaryPart then
                        table. insert(currentMacroData, {
                            Action = "Sell",
                            Time = currentTime,
                            Wave = currentWave,
                            Cost = 0,
                            CFrame = u.PrimaryPart.CFrame
                        })
                    end
                    
                elseif rName == "UnitAbility" then
                    local u = args[2]
                    if u and u.PrimaryPart then
                        table.insert(currentMacroData, {
                            Action = "Ability",
                            Time = currentTime,
                            Wave = currentWave,
                            Cost = 0,
                            SkillName = args[1],
                            CFrame = u.PrimaryPart. CFrame,
                            AbilityData = args[3]
                        })
                    end
                end
            end)
        end)
    end
    
    return oldNamecall(self, ...)
end)

setreadonly(mt, true)

