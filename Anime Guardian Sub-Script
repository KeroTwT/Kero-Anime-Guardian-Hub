task.spawn(function()
    local CardVote = ReplicatedStorage:WaitForChild("PlayMode"):WaitForChild("Events"):WaitForChild("CardVote")
    while true do
        if isAutoCardSelect then
            -- Step 1: Read the 3 cards currently displayed on screen
            local displayed = getDisplayedCards()
            
            if #displayed > 0 then
                -- Step 2: Among displayed cards, find best priority with count < limit
                local bestCard = nil
                local bestPriority = math.huge
                
                for _, cardName in ipairs(displayed) do
                    local cfg = cardConfig[cardName]
                    if cfg and cfg.priority > 0 then
                        local currentCount = getCardGameCount(cardName)
                        -- Check if limit is set (>0) and count hasn't exceeded it
                        local withinLimit = (cfg.limit > 0) and (currentCount < cfg.limit)
                        if withinLimit and cfg.priority > 0 and cfg.priority < bestPriority then
                            bestCard = cardName
                            bestPriority = cfg.priority
                        end
                    end
                end
                
                -- Step 3: Vote for the best card
                if bestCard then
                    local currentCount = getCardGameCount(bestCard)
                    local cfg = cardConfig[bestCard]
                    local ok, err = pcall(function()
                        CardVote:FireServer(bestCard)
                    end)
                    if ok then
                        local limitStr = tostring(cfg.limit)
                        CardStatusLabel:Set("Voted: " .. bestCard .. " [" .. currentCount .. "/" .. limitStr .. "] | Shown: " .. table.concat(displayed, ", "))
                    else
                        CardStatusLabel:Set("Error: " .. tostring(err))
                    end
                else
                    -- No valid card among displayed ones
                    CardStatusLabel:Set("No priority match in: " .. table.concat(displayed, ", "))
                end
            end
        end
        task.wait(1)
    end
end)

