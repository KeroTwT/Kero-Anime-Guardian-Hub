local function getEquippedUnits()
    local units = {}
    local unitsFrame = LocalPlayer.PlayerGui:FindFirstChild("Main")
                        and LocalPlayer.PlayerGui.Main:FindFirstChild("UnitBar")
                        and LocalPlayer.PlayerGui.Main.UnitBar:FindFirstChild("UnitsFrame")
                        and LocalPlayer.PlayerGui.Main.UnitBar.UnitsFrame:FindFirstChild("UnitsSlot")

    if unitsFrame then
        for i = 1, 6 do
            local slot = unitsFrame:FindFirstChild("unit" .. i)
            if slot then
                local unitName = nil
                local uuid = nil
                local price = 0
                
                -- Tìm StringValue chứa tên Unit và UUID (Value)
                for _, child in ipairs(slot:GetChildren()) do
                    if child:IsA("StringValue") and child.Name ~= "Lock" and child.Name ~= "Empty" and child.Name ~= "unit" and child.Name ~= "traits" then
                        unitName = child.Name
                        uuid = child.Value
                        break
                    end
                end
                
                if unitName and uuid then
                    for _, descendant in ipairs(slot:GetDescendants()) do
                        if descendant.Name == "yen" and descendant:IsA("TextLabel") then
                            price = cleanNumber(descendant.Text)
                            break
                        end
                    end
                    
                    table.insert(units, {
                        slotNum = i,
                        uuid = uuid,
                        name = unitName,
                        price = price
                    })
                end
            end
        end
    end
    return units
end

local function getPlacedUnitsInfo()
    local placed = {}
    local unitServer = workspace:FindFirstChild("Ground") 
                       and workspace.Ground:FindFirstChild("unitServer") 
                       and workspace.Ground.unitServer:FindFirstChild(LocalPlayer.Name .. " (UNIT)")
                       
    if unitServer then
        -- Count total placements
        local maxFolder = unitServer:FindFirstChild("PLACEMENTFOLDER")
        local globalPlacements = {}
        
        if maxFolder then
            for _, folder in ipairs(maxFolder:GetChildren()) do
                local uName = string.gsub(folder.Name, " PLACEMENT$", "")
                local cur = folder:FindFirstChild("placement") and folder.placement.Value or 0
                local mx = folder:FindFirstChild("maxplacement") and folder.maxplacement.Value or 0
                globalPlacements[uName] = {current = cur, max = mx}
            end
        end
        
        -- Get specific units
        for _, obj in ipairs(unitServer:GetChildren()) do
            if obj.Name ~= "PLACEMENTFOLDER" then
                local upgrade = obj:FindFirstChild("Upgrade") and obj.Upgrade.Value or 0
                local maxUpgrade = obj:FindFirstChild("MaxUpgrade") and obj.MaxUpgrade.Value or 0
                local priceUpgrade = obj:FindFirstChild("PriceUpgrade") and obj.PriceUpgrade.Value or 0
                
                table.insert(placed, {
                    instanceName = obj.Name,
                    unitName = string.gsub(obj.Name, " %%d+$", ""),
                    upgrade = upgrade,
                    maxUpgrade = maxUpgrade,
                    priceUpgrade = priceUpgrade,
                    model = obj
                })
            end
        end
        
        return placed, globalPlacements
    end
    return placed, {}
end

local function getTargetWaypointPart(waypointNum)
    local main = workspace:FindFirstChild("Main")
    if not main then return nil end
    
    if isAutoMiddleMap then
        local wp2 = main:FindFirstChild("Waypoints 2")
        if wp2 then
            local wp19 = wp2:FindFirstChild("19")
            if wp19 then return wp19 end
        end
    end
    
    local wpStr = tostring(waypointNum)
    for _, child in ipairs(main:GetChildren()) do
        if string.match(child.Name, "^Waypoints") then
            local wp = child:FindFirstChild(wpStr)
            if wp then return wp end
        end
    end
    return nil
end

local function getValidPlacementCFrame(waypointNum)
    local targetWP = getTargetWaypointPart(waypointNum)
    if not targetWP then return nil end
    
    -- Thử quét nhiều vị trí ngẫu nhiên xung quanh waypoint
    for i = 1, 30 do -- Tăng số lần thử để dễ tìm góc hẹp
        local angle = math.random(0, 360)
        local rad = math.rad(angle)
        local distance = math.random(3, placementRadius)
        local offsetX = math.cos(rad) * distance
        local offsetZ = math.sin(rad) * distance
        
        local wpPos = targetWP.Position
        local targetPos = Vector3.new(wpPos.X + offsetX, wpPos.Y + 30, wpPos.Z + offsetZ)
        
        local rayOrigin = targetPos
        local rayDirection = Vector3.new(0, -60, 0)
        local raycastParams = RaycastParams.new()
        
        raycastParams.FilterDescendantsInstances = {
            LocalPlayer.Character,
            workspace:FindFirstChild("Ground"),
            workspace:FindFirstChild("Enemies"),
            workspace:FindFirstChild("Enemy")
        }
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local rayResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
        if rayResult and rayResult.Instance then
            local hitName = string.lower(rayResult.Instance.Name)
            if not string.find(hitName, "path") and not string.find(hitName, "road") then
                return CFrame.new(rayResult.Position.X, rayResult.Position.Y, rayResult.Position.Z)
            end
        end
    end
    
    return nil
end

-- Get the 3 cards currently displayed on the vote screen
-- Path: PlayerGui.CardVote.Frame.Inset.Sctroll[cardName]
-- All cards always exist, so we check Visible to find which 3 are active
local function getDisplayedCards()
    local found = {}
    local cardVoteGui = LocalPlayer.PlayerGui:FindFirstChild("CardVote")
    if not cardVoteGui then return found end
    local frame = cardVoteGui:FindFirstChild("Frame")
    if not frame then return found end
    local inset = frame:FindFirstChild("Inset")
    if not inset then return found end
    local scroll = inset:FindFirstChild("Sctroll")
    if not scroll then return found end
    
    for _, child in ipairs(scroll:GetChildren()) do
        -- Only check actual card frames (skip UIListLayout, etc.)
        if child:IsA("GuiObject") and child.Visible and cardConfig[child.Name] then
            table.insert(found, child.Name)
        end
    end
    return found
end

