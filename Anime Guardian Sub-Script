task.spawn(function()
    while true do
        if isAutoPlay then
            local EventsFolder = ReplicatedStorage:FindFirstChild("PlayMode") 
                                 and ReplicatedStorage.PlayMode:FindFirstChild("Events")
            
            if EventsFolder then
                local spawnEvent = EventsFolder:FindFirstChild("spawnunit")
                local manageEvent = EventsFolder:FindFirstChild("ManageUnits")
                
                if spawnEvent and manageEvent then
                    local money = getMyMoney()
                    local placedUnits, limits = getPlacedUnitsInfo()
                    local equippedUnits = getEquippedUnits()
                    local actionDone = false
                    
                    -- PHASE 1: PLACEMENT (Bắt buộc đặt max limit tất cả trước)
                    local allMaxed = true
                    local targetPlace = nil

                    for _, eqUnit in ipairs(equippedUnits) do
                        local curP = 0
                        local maxP = 1 -- Fallback nếu chưa có folder
                        if limits[eqUnit.name] then
                            curP = limits[eqUnit.name].current
                            maxP = limits[eqUnit.name].max
                        end
                        
                        if curP < maxP then
                            allMaxed = false -- Còn unit chưa đặt max
                            if money >= eqUnit.price and not targetPlace then
                                targetPlace = eqUnit
                            end
                        end
                    end
                    
                    if not allMaxed then
                        actionDone = true -- Khóa Upgrade hoàn toàn cho tới khi allMaxed = true
                        if targetPlace then
                            local placeCFrame = getValidPlacementCFrame(targetWaypoint)
                            if placeCFrame then
                                AutoStatusLabel:Set("Status: Placing " .. targetPlace.name)
                                local args = {
                                    [1] = {
                                        [1] = targetPlace.name,
                                        [2] = placeCFrame,
                                        [3] = 0
                                    },
                                    [2] = targetPlace.uuid
                                }
                                
                                pcall(function() spawnEvent:InvokeServer(unpack(args)) end)
                                task.wait(actionDelay)
                            else
                                AutoStatusLabel:Set("Status: Finding Raycast Position...")
                            end
                        else
                            AutoStatusLabel:Set("Status: Waiting Money To Place...")
                        end
                    end
                    
                    -- PHASE 2: UPGRADE
                    if not actionDone then
                        local upgradeableUnits = {}
                        
                        for _, unit in ipairs(placedUnits) do
                            if unit.upgrade < unit.maxUpgrade and money >= unit.priceUpgrade then
                                table.insert(upgradeableUnits, unit)
                            end
                        end
                        
                        if #upgradeableUnits > 0 then
                            local targetUpgrade = nil
                            
                            for pIndex = 1, 6 do
                                local pSlot = upgradePriorities[pIndex]
                                if pSlot > 0 then
                                    local targetName = nil
                                    for _, eq in ipairs(equippedUnits) do
                                        if eq.slotNum == pSlot then
                                            targetName = eq.name
                                            break
                                        end
                                    end
                                    
                                    if targetName then
                                        for _, u in ipairs(upgradeableUnits) do
                                            if string.find(string.lower(u.instanceName), string.lower(targetName), 1, true) then
                                                targetUpgrade = u
                                                break
                                            end
                                        end
                                    end
                                end
                                if targetUpgrade then break end
                            end
                            
                            if not targetUpgrade then
                                targetUpgrade = upgradeableUnits[1]
                            end
                            
                            if targetUpgrade then
                                AutoStatusLabel:Set("Status: Upgrading " .. targetUpgrade.instanceName)
                                pcall(function()
                                    manageEvent:InvokeServer("Upgrade", targetUpgrade.instanceName)
                                end)
                                actionDone = true
                                task.wait(upgradeDelay)
                            end
                        end
                    end
                    
                    if not actionDone then
                        AutoStatusLabel:Set("Status: Idle")
                    end
                end
            else
                AutoStatusLabel:Set("Status: Waiting for Match...")
            end
        end
        task.wait(0.2)
    end
end)

