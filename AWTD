function playMacro()
    if #currentMacroData == 0 then
        return
    end
    isPlaying = true
    PlacedUnitsRegistry = {}
    task.spawn(function()
        UpdateStatus("Starting...", "Match Start")
        local startT = tick()
        local step   = 1
        local R      = ReplicatedStorage:WaitForChild("Remote")
        local Rem = {
            Spawn     = R:FindFirstChild("SpawnUnit"),
            Sell      = R:FindFirstChild("SellUnit"),
            Upgrade   = R:FindFirstChild("UpgradeUnit"),
            Ability   = R:FindFirstChild("UnitAbility"),
            TargetMode= R:FindFirstChild("ChangeUnitModeFunction"),
            BuyMeat   = R:FindFirstChild("BuyMeat"),
            FeedAll   = R:FindFirstChild("FeedAll"),
            Skip      = R:FindFirstChild("SkipEvent"),
            Speed     = R:FindFirstChild("x2Event")
        }
        while isPlaying do
            if getgenv().StopAllMacros then break end
            local eff = Workspace:FindFirstChild("Effect")
            if eff and (eff:FindFirstChild("Gameover") or eff:FindFirstChild("Victory")) then
                isPlaying = false
                UpdateStatus("Stopped", "Game Ended")
                break
            end
            if step <= #currentMacroData then
                local act    = currentMacroData[step]
                local passed = tick() - startT
                local cash   = getCash()
                local cost   = act.Cost or 0
                local readyT = passed >= act.Time
                local readyM = true
                if playbackMode ~= "Time" and cost > 0 then
                    readyM = cash >= cost
                end
                if (playbackMode == "Time" and readyT) or (playbackMode == "Money" and readyM) or (readyT and readyM) then
                    local stepDone = false
                    UpdateStatus("Executing", "Step: " .. step .. " | " .. act.Action)
                    if act.Action == "Place" and Rem.Spawn then
                        local attempts = 0
                        repeat
                            if getgenv().StopAllMacros or not isPlaying then break end
                            local u = findUnitByCFrame(act.CFrame, true)
                            if u then
                                stepDone = true
                                PlacedUnitsRegistry[u] = true
                            else
                                attempts = attempts + 1
                                if attempts > 200 then
                                    stepDone = true
                                else
                                    if getCash() >= cost then
                                        SmartFire(Rem.Spawn, {act.UnitName, act.CFrame, act.Slot, act.Data}, 3)
                                    end
                                    task.wait(0.1)
                                end
                            end
                        until stepDone
                    elseif act.Action == "Upgrade" and Rem.Upgrade then
                        local u = findUnitByCFrame(act.CFrame, false)
                        if u then
                            if getUnitUpgradeCost(u) <= 0 then
                                stepDone = true
                            else
                                if getCash() >= cost then
                                    SmartFire(Rem.Upgrade, {u}, 3)
                                    stepDone = true
                                else
                                    UpdateStatus("Waiting Cash", "Needed: " .. cost)
                                end
                            end
                        else
                            stepDone = true
                        end
                    elseif act.Action == "Sell" and Rem.Sell then
                        local u = findUnitByCFrame(act.CFrame, false)
                        if u then
                            SmartFire(Rem.Sell, {u}, 3)
                        end
                        stepDone = true
                    elseif act.Action == "TargetMode" and Rem.TargetMode then
                        local u = findUnitByCFrame(act.CFrame, false)
                        if u then
                            SmartFire(Rem.TargetMode, {u}, 3)
                        end
                        stepDone = true
                    elseif act.Action == "AutoSkill" then
                        local u = findUnitByCFrame(act.CFrame, false)
                        if u and u:FindFirstChild("Info") then
                            local autoVal = u.Info:FindFirstChild("AutoAbility")
                            if autoVal and autoVal:IsA("BoolValue") then
                                autoVal.Value = act.State
                            end
                        end
                        stepDone = true
                    elseif act.Action == "Ability" and Rem.Ability then
                        local u = findUnitByCFrame(act.CFrame, false)
                        if u then
                            if act.AbilityData then
                                SmartFire(Rem.Ability, {act.SkillName, u, act.AbilityData}, 3)
                            else
                                SmartFire(Rem.Ability, {act.SkillName, u}, 3)
                            end
                        end
                        stepDone = true
                    elseif act.Action == "BuyMeat" and Rem.BuyMeat then
                        SmartFire(Rem.BuyMeat, act.Args or {}, 3)
                        stepDone = true
                    elseif act.Action == "FeedAll" and Rem.FeedAll then
                        SmartFire(Rem.FeedAll, {}, 3)
                        stepDone = true
                    elseif act.Action == "SkipEvent" and Rem.Skip then
                        SmartFire(Rem.Skip, {}, 3)
                        stepDone = true
                    elseif act.Action == "SkipWave" and Rem.Skip then
                        SmartFire(Rem.Skip, {}, 3)
                        stepDone = true
                    elseif act.Action == "AutoSpeed" and Rem.Speed then
                        SmartFire(Rem.Speed, {}, 3)
                        stepDone = true
                    else
                        stepDone = true
                    end
                    if stepDone then
                        step = step + 1
                    end
                else
                    local stepName = act.Action
                    if act.UnitName then
                        stepName = stepName .. " [" .. act.UnitName .. "]"
                    end
                    if act.SkillName then
                        stepName = stepName .. " [" .. act.SkillName .. "]"
                    end
                    local waitInfo = ""
                    if not readyT then
                        waitInfo = string.format("Wait Time: %.1fs", act.Time - passed)
                    elseif not readyM then
                        waitInfo = string.format("Wait Cash: %d/%d", cash, cost)
                    end
                    UpdateStatus("Waiting", string.format("Next: %s\nCost: %d$\n%s", stepName, cost, waitInfo))
                end
            else
                UpdateStatus("Waiting", "Macro Done")
            end
            task.wait(0.05)
        end
    end)
end

-- Auto Reveal Grave: highlight unopened graves based on decal color
local AutoGraveHighlights = {}
function StartAutoRevealGrave()
    task.spawn(function()
        local revealStart = tick()
        while getgenv().AutoRevealGraveLoop do
            local map = Workspace:FindFirstChild("Map")
            local gravesFolder = map and map:FindFirstChild("Graves")
            if gravesFolder then
                for _, grave in pairs(gravesFolder:GetChildren()) do
                    local part = grave:FindFirstChild("Part")
                    local decal = part and part:FindFirstChild("Decal")
                    if part and decal then
                        local color = decal.Color3
                        local r, g, b = color.R * 255, color.G * 255, color.B * 255
                        -- Determine categories by RGB thresholds
                        local isBlack = (r < 10 and g < 10 and b < 10)
                        local isRed   = (r > 200 and g < 50 and b < 50)
                        -- skip opened graves (black)
                        local hl = AutoGraveHighlights[grave]
                        if not isBlack then
                            -- skip red graves until 10 seconds have passed since reveal started
                            if isRed and (tick() - revealStart < 10) then
                                -- remove highlight if accidentally exists
                                if hl then
                                    hl:Destroy()
                                    AutoGraveHighlights[grave] = nil
                                end
                            else
                                -- highlight yellow/white graves immediately and red after delay
                                if not hl then
                                    hl = Instance.new("Highlight")
                                    hl.Name = "AutoGraveHighlight"
                                    hl.FillColor = color
                                    hl.FillTransparency = 0.5
                                    hl.OutlineColor = color
                                    hl.OutlineTransparency = 0
                                    hl.Adornee = part
                                    hl.Parent = part
                                    AutoGraveHighlights[grave] = hl
                                else
                                    hl.FillColor = color
                                    hl.OutlineColor = color
                                    hl.Adornee = part
                                end
                            end
                        else
                            if hl then
                                hl:Destroy()
                                AutoGraveHighlights[grave] = nil
                            end
                        end
                    end
                end
            end
            task.wait(1)
        end
        -- cleanup all highlights
        for g, hl in pairs(AutoGraveHighlights) do
            if hl then
                hl:Destroy()
            end
        end
        AutoGraveHighlights = {}
    end)
end

-- Auto Upgrade units: upgrade owned units when enough cash
function StartAutoUpgrade()
    task.spawn(function()
        while getgenv().AutoUpgradeLoop do
            if getgenv().StopAllMacros then break end
            local unitsFolder = Workspace:FindFirstChild("Units")
            local cash = getCash()
            if unitsFolder and cash > 0 then
                for _, unit in pairs(unitsFolder:GetChildren()) do
                    local ownerTag = unit:FindFirstChild("Owner") or (unit:FindFirstChild("Info") and unit.Info:FindFirstChild("Owner"))
                    local isMine = false
                    if ownerTag then
                        if ownerTag.Value == LocalPlayer or tostring(ownerTag.Value) == LocalPlayer.Name or tonumber(ownerTag.Value) == LocalPlayer.UserId then
                            isMine = true
                        end
                    end
                    if isMine then
                        local cost = getUnitUpgradeCost(unit)
                        if cost > 0 and getCash() >= cost then
                            local remote = ReplicatedStorage:FindFirstChild("Remote") and ReplicatedStorage.Remote:FindFirstChild("UpgradeUnit")
                            if remote then
                                SmartFire(remote, {unit}, 3)
                                -- wait a bit to allow upgrade to register
                                task.wait(0.3)
                                break
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

-- Determine a CFrame near WayPoint 3 for unit placement
local function GetAutoPlaceCFrame()
    local map = Workspace:FindFirstChild("Map")
    local waypointFolder = map and map:FindFirstChild("WayPoint")
    local wp = waypointFolder and waypointFolder:FindFirstChild("3")
    if wp and wp:IsA("BasePart") then
        local cf = wp.CFrame
        -- Offset slightly to the right and forward relative to the path
        local pos = cf.Position + cf.RightVector * 4 + cf.LookVector * 2
        return CFrame.new(pos)
    end
    return CFrame.new()
end

-- Auto place: spawn random units obtained from graves near WayPoint 3
local AutoPlaceConnection
local function StopAutoPlace()
    if AutoPlaceConnection then
        AutoPlaceConnection:Disconnect()
        AutoPlaceConnection = nil
    end
end
local function StartAutoPlace()
    StopAutoPlace()
    task.spawn(function()
        -- Wait for GraveEventUI world model
        local gui
        local startTime = tick()
        repeat
            if getgenv().StopAllMacros or not getgenv().AutoPlayGraveLoop then return end
            gui = LocalPlayer.PlayerGui:FindFirstChild("GraveEventUI")
            task.wait(0.5)
        until gui or (tick() - startTime > 10)
        if not gui then return end
        local worldModel
        -- Search descendants for WorldModel
        for _, desc in pairs(gui:GetDescendants()) do
            if desc:IsA("WorldModel") then
                worldModel = desc
                break
            end
        end
        if worldModel then
            AutoPlaceConnection = worldModel.ChildAdded:Connect(function(child)
                -- only handle when auto play still enabled
                if not getgenv().AutoPlayGraveLoop or getgenv().StopAllMacros then return end
                -- spawn the unit after short delay to ensure remote ready
                local unitName = child.Name
                local spawnRemote = ReplicatedStorage:FindFirstChild("Remote") and ReplicatedStorage.Remote:FindFirstChild("SpawnUnit")
                if spawnRemote then
                    -- compute CFrame for placement
                    local cf = GetAutoPlaceCFrame()
                    -- Try calling SpawnUnit with full argument list (unitName, CFrame, slot, data)
                    local ok = pcall(function()
                        spawnRemote:FireServer(unitName, cf, 1, {})
                    end)
                    -- Fallback: attempt simplified call if the above fails
                    if not ok then
                        pcall(function()
                            spawnRemote:FireServer(unitName, cf)
                        end)
                    end
                end
            end)
        end
    end)
end

-- Auto Play graves: open graves and place units
function StartAutoPlayGrave()
    -- prevent overlapping loops
    if getgenv().AutoPlayGraveLoopRunning then return end
    getgenv().AutoPlayGraveLoopRunning = true
    -- Start auto place when auto play begins
    StartAutoPlace()
    task.spawn(function()
        while getgenv().AutoPlayGraveLoop do
            if getgenv().StopAllMacros then break end
            local map = Workspace:FindFirstChild("Map")
            local gravesFolder = map and map:FindFirstChild("Graves")
            if gravesFolder then
                for _, grave in pairs(gravesFolder:GetChildren()) do
                    if not getgenv().AutoPlayGraveLoop or getgenv().StopAllMacros then break end
                    local part = grave:FindFirstChild("Part")
                    local graveEvent = part and part:FindFirstChild("GraveEvent")
                    local decal = part and part:FindFirstChild("Decal")
                    if graveEvent and decal then
                        local color = decal.Color3
                        local isBlack = (color.R + color.G + color.B) < 0.1
                        if not isBlack then
                            local remote = ReplicatedStorage:FindFirstChild("Remote") and ReplicatedStorage.Remote:FindFirstChild("GraveEvent")
                            if remote then
                                SmartFire(remote, {graveEvent}, 3)
                            end
                            -- Red graves spawn boss; wait longer
                            local isRed = (color.R > 0.6 and color.G < 0.4 and color.B < 0.4)
                            if isRed then
                                task.wait(15)
                                task.wait(10)
                            else
                                task.wait(1)
                            end
                        end
                    end
                end
            end
            task.wait(1)
        end
        -- cleanup on stop
        StopAutoPlace()
        getgenv().AutoPlayGraveLoopRunning = false
    end)
end

function StopAutoPlayGrave()
    getgenv().AutoPlayGraveLoop = false
    StopAutoPlace()
end

