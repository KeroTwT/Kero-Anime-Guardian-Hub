local function SaveCurrentMacro()
    if currentMacroName == "" then return end
    local encoded = {}
    for _, action in ipairs(currentMacroData) do
        local cloned = table.clone(action)
        if cloned.CFrame and typeof(cloned.CFrame) == "CFrame" then
            cloned.CFrame = CFrameToTable(cloned.CFrame)
        end
        table.insert(encoded, cloned)
    end
    pcall(function()
        writefile(MACRO_FOLDER .. "/" .. currentMacroName .. ".json", HttpService:JSONEncode(encoded))
    end)
    Fluent:Notify({Title="Macro", Content="Saved: " .. currentMacroName, Duration=2})
    pcall(function()
        SaveManager:Save(AutoConfigName)
    end)
end

local function LoadMacro(name)
    local filePath = MACRO_FOLDER .. "/" .. name .. ".json"
    if not isfile(filePath) then return end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(filePath))
    end)
    if not success then return end
    currentMacroData = {}
    for _, data in ipairs(result) do
        local action = table.clone(data)
        if action.CFrame and type(action.CFrame) == "table" then
            action.CFrame = TableToCFrame(action.CFrame)
        end
        table.insert(currentMacroData, action)
    end
    currentMacroName = name
    Fluent:Notify({Title="Macro", Content="Loaded: " .. name, Duration=2})

    playMacro()
end

local function GetMacroFiles()
    local files = listfiles(MACRO_FOLDER)
    local names = {}
    for _, path in ipairs(files) do
        local nm = path:match("([^/]+)%.json$")
        if nm then table.insert(names, nm) end
    end
    table.sort(names)
    return names
end

local function MonitorUnitAutoSkill(unit)
    if not unit then return end
    task.spawn(function()
        local info = unit:WaitForChild("Info", 5)
        if info then
            local autoVal = info:WaitForChild("AutoAbility", 5)
            if autoVal and autoVal:IsA("BoolValue") then
                local conn
                conn = autoVal.Changed:Connect(function(newVal)
                    if isRecording then
                        local currentTime = tick() - startTime
                        local currentWave = getWave()
                        if unit.PrimaryPart then
                            table.insert(currentMacroData, {
                                Action = "AutoSkill",
                                Time   = currentTime,
                                Wave   = currentWave,
                                Cost   = 0,
                                CFrame = unit.PrimaryPart.CFrame,
                                State  = newVal
                            })
                        end
                    end
                end)
                table.insert(AutoSkillConnections, conn)
            end
        end
    end)
end

local function CleanupAutoSkillConnections()
    for _, conn in pairs(AutoSkillConnections) do
        if conn then conn:Disconnect() end
    end
    AutoSkillConnections = {}
end


